<div class="cart-drawer" id="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="cart-drawer-title" hidden data-free-delivery-cents="{{ settings.free_delivery_threshold | times: 100 }}">
  <div class="cart-drawer__backdrop" data-cart-close></div>
  <div class="cart-drawer__panel" tabindex="-1" data-cart-panel>
    <div class="cart-drawer__header">
      <h2 id="cart-drawer-title">Your order</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">&times;</button>
    </div>

    <div class="cart-drawer__delivery">
      <p data-delivery-message></p>
      <div class="cart-drawer__bar" aria-hidden="true"><span data-delivery-bar></span></div>
    </div>

    <p class="cart-drawer__empty" data-cart-empty>Your basket is empty.</p>
    <ul class="cart-drawer__items" data-cart-items></ul>

    <form class="cart-drawer__addons" data-cart-addons>
      <label for="delivery-note">Delivery note (optional)</label>
      <textarea id="delivery-note" name="delivery_note" maxlength="140" rows="2" placeholder="For example: ring the bell twice">{{ cart.attributes['Delivery note'] | escape }}</textarea>
      <label class="cart-drawer__checkbox">
        <input type="checkbox" name="leave_at_door" {% if cart.attributes['Leave at door'] == 'Yes' %}checked{% endif %}>
        Leave at the door
      </label>
      <button type="submit" class="button button--secondary" data-save-addons>Save delivery options</button>
      <p class="cart-drawer__status" role="status" data-addons-status></p>
    </form>

    <div class="cart-drawer__footer">
      <p>Subtotal <span data-cart-subtotal>{{ cart.total_price | money }}</span></p>
      <a class="button" href="/checkout">Checkout</a>
    </div>
  </div>
</div>
