<a class="product-card" href="{{ product.url }}">
  {% if product.featured_image %}
    {{ product.featured_image | image_url: width: 600 | image_tag: class: 'product-card__image', loading: 'lazy', sizes: '(min-width: 750px) 25vw, 50vw', alt: product.featured_image.alt | escape }}
  {% endif %}
  <h2 class="product-card__title">{{ product.title | escape }}</h2>
  <p class="product-card__price">{{ product.price | money }}</p>
</a>
